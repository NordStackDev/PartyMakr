# Copy this file to .env.local and fill in your Supabase project credentials.
# Get these from https://app.supabase.com -> Your Project -> Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-only, never expose to the client.
# Used by scripts / server actions that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile — bot protection on the auth forms (signup/login/reset).
# Free key: https://dash.cloudflare.com -> Turnstile -> Add site.
# The SITE key is public (goes here). The SECRET key goes into Supabase:
#   Auth -> Settings -> enable CAPTCHA protection -> provider "Turnstile" ->
#   paste the secret. Leave this unset and the widget simply won't render
#   (auth keeps working) until you configure both sides together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Stripe (Connect + Checkout) — server-side. Hosts onboard as Express accounts;
# the guest pays entré + billetgebyr, the host receives the full entré, and the
# fee stays with the platform (covers Stripe's processing cost). Enable
# MobilePay as a payment method under Settings -> Payment methods in the Stripe
# dashboard. Payment features are disabled until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# From `stripe listen` locally, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Billetgebyr per ticket in whole DKK, paid by the guest on top of the entré.
PLATFORM_FEE_DKK=5

# Absolute origin used to build Stripe return/webhook URLs (e.g.
# https://partymakr.app). On localhost payment is reconciled on return instead
# of relying on the webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Idura Verify — age verification via MitID (OIDC). Server-only; the callback
# exchanges the code with the client secret. Register an "Age Verification"
# app in Idura with redirect URI <site>/api/verify/mitid/callback. Leave unset
# and the app falls back to the dev age stub in settings.
IDURA_ISSUER=https://your-subdomain.test.idura.broker
IDURA_CLIENT_ID=urn:my:application:identifier:000000
IDURA_CLIENT_SECRET=your-idura-client-secret
# Optional MitID acr, only if the broker requires it explicitly:
# IDURA_ACR=urn:grn:authn:dk:mitid:substantial
